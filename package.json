{
  "name": "ui-level",
  "version": "1.0.0",
  "description": "Deterministic visual & CSS spec regression engine for HTML, Figma, and PNG/SVG",
  "author": "Abolfazl Moeini",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/abolfazl-moeini/ui-level.git"
  },
  "homepage": "https://github.com/abolfazl-moeini/ui-level#readme",
  "bugs": {
    "url": "https://github.com/abolfazl-moeini/ui-level/issues"
  },
  "keywords": [
    "visual-regression",
    "ui-testing",
    "figma",
    "css",
    "playwright",
    "odiff",
    "mcp",
    "ciede2000"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "type": "module",
  "bin": {
    "ui-level": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "Dockerfile"
  ],
  "scripts": {
    "build": "tsup && node -e \"require('node:fs').chmodSync('dist/cli.js', 0o755)\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "doctor": "node ./dist/cli.js doctor",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@figma/rest-api-spec": "^0.47.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "colorjs.io": "^0.7.1",
    "commander": "^15.1.0",
    "odiff-bin": "^4.5.0",
    "playwright-core": "^1.65.1",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.13.1",
    "tsup": "^8.3.6",
    "typescript": "^5.8.2",
    "vitest": "^3.0.5"
  }
}
